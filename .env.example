# ─────────────────────────────────────────────────────────────────────────────
# UniNotepad environment template
#
# Copy to `.env` and fill in. NEVER commit a real `.env` — it is gitignored.
# Values here are placeholders only.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Neon PostgreSQL, or any Postgres 14+) ──────────────────────────
# Neon: copy the pooled connection string from your project dashboard.
DATABASE_URL="postgresql://user:password@host.neon.tech/uninotepad?sslmode=require"

# Optional: a SEPARATE database used by the integration test suite.
# When unset, `pnpm test` runs unit tests only. The suite truncates tables —
# never point this at a database with real data.
DATABASE_URL_TEST=""

# ── Authentication (NextAuth v5) ─────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
# Must be at least 32 bytes. Rotating this invalidates every existing session.
AUTH_SECRET=""
AUTH_TRUST_HOST=true
NEXTAUTH_URL="http://localhost:3000"

# Optional social sign-in. Leave blank to disable those buttons.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""

# ── First-run installation ───────────────────────────────────────────────────
# Required to run the setup wizard at /setup, which creates the first ADMIN
# account. Without it the wizard refuses to run (503), so a freshly deployed
# instance cannot be claimed by whoever finds the URL first.
# Generate with: openssl rand -hex 32
# Remove or rotate this value once installation is complete.
SETUP_TOKEN=""

# ── Domain / routing ─────────────────────────────────────────────────────────
# Used by proxy.ts to derive the admin.* and lecturer.* subdomains.
# Local development: use admin.localhost:3000 / lecturer.localhost:3000.
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"

# Absolute base URL used in outbound emails (password reset links).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional link to the separately deployed UniNotepad marketing website.
# The application intentionally does not contain or serve marketing pages.
NEXT_PUBLIC_MARKETING_URL=""

# ── Local demo seed (never enable in production) ────────────────────────────────────────
# prisma/seed.ts refuses to run unless this explicit opt-in is true and
# NODE_ENV is not production. Use only with an isolated development database.
ALLOW_DEMO_SEED=false
SEED_MODE="minimal"
DEMO_ADMIN_PASSWORD=""
# Required only when SEED_MODE=full.
DEMO_LECTURER_PASSWORD=""
DEMO_STUDENT_PASSWORD=""

# ── AI (Google Gemini) ───────────────────────────────────────────────────────
# Environment variables take precedence over keys stored in AppSettings, so you
# can keep secrets out of the database entirely.
GEMINI_API_KEY=""

# ── File storage (Cloudinary) ────────────────────────────────────────────────
# Server-side only. Never prefix these with NEXT_PUBLIC_ — that would ship the
# API secret to every browser.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Required for password-reset delivery. Without it, resets are logged as an
# error server-side and no email is sent.
RESEND_API_KEY=""
EMAIL_FROM="UniNotepad <onboarding@resend.dev>"

# ── Text-to-speech (optional) ────────────────────────────────────────────────
ELEVENLABS_API_KEY=""

# ── Payments (optional; webhook handlers are NOT implemented) ────────────────
# See docs/SYSTEM_AUDIT.md → Remaining deployment risks before enabling these.
MONIME_API_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Support ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPPORT_EMAIL="support@example.edu"
